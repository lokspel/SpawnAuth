<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>me.lokspel</groupId>
  <artifactId>spawnauth</artifactId>
  <version>1.0.9</version>
  <name>SpawnAuth</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>

    <!-- Runtime dependencies -->
    <paper.version>[26.2.build,)</paper.version>
    <authme.version>5.7.0-SNAPSHOT</authme.version>
    <nlogin.version>10.4</nlogin.version>
    <openlogin.version>1.3</openlogin.version>
    <loginsecurity.version>3.3.1</loginsecurity.version>
    <bstats.version>3.2.1</bstats.version>
    <folialib.version>0.5.1</folialib.version>

    <!-- Build tooling -->
    <compiler.version>3.15.0</compiler.version>
    <shade.version>3.6.0</shade.version>
  </properties>

  <!-- Repositories grouped by dependency -->
  <repositories>
    <repository>
      <id>papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>codemc-repo</id>
      <url>https://repo.codemc.org/repository/maven-public/</url>
    </repository>
    <repository>
      <id>nickuc-repo</id>
      <url>https://repo.nickuc.com/maven-releases/</url>
    </repository>
    <repository>
      <id>bstats-repo</id>
      <url>https://repo.bstats.org/maven/</url>
    </repository>
    <repository>
      <id>tcoded-releases</id>
      <url>https://repo.tcoded.com/releases</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- API (provided by server) -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>fr.xephi</groupId>
      <artifactId>authme</artifactId>
      <version>${authme.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.nickuc.login</groupId>
      <artifactId>api</artifactId>
      <version>${nlogin.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.nickuc.openlogin</groupId>
      <artifactId>openlogin-universal</artifactId>
      <version>${openlogin.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.lenis0012.bukkit</groupId>
      <artifactId>loginsecurity</artifactId>
      <version>${loginsecurity.version}</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/libs/LoginSecurity-Spigot-${loginsecurity.version}.jar</systemPath>
    </dependency>

    <!-- Compile-time only (shaded into the final jar) -->
    <dependency>
      <groupId>org.bstats</groupId>
      <artifactId>bstats-bukkit</artifactId>
      <version>${bstats.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.tcoded</groupId>
      <artifactId>FoliaLib</artifactId>
      <version>${folialib.version}</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>SpawnAuth-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.version}</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>org.bstats</pattern>
                  <shadedPattern>me.lokspel.spawnauth.thirdparty</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.tcoded.folialib</pattern>
                  <shadedPattern>me.lokspel.spawnauth.thirdparty.folialib</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>